# Backend environment variables
# Copy this file to `.env` for local development and fill in real values.
# NEVER commit your actual `.env` file with real secrets.
#
# In production (Render), set ALL of these in the Render dashboard instead.

# Django secret key - REQUIRED in production. Use a long random 50+ char value.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Debug mode. MUST be "False" in production.
DEBUG=False

# Comma-separated list of allowed hosts. Add your Render domain here in prod.
# Example: localhost,127.0.0.1,my-app.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL database connection
DB_NAME=hrms_db
DB_USER=hrms_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# MySQL SSL mode: DISABLED, PREFERRED, or REQUIRED
# Use REQUIRED for hosted MySQL that enforces TLS (e.g. many free hosts)
DB_SSL_MODE=DISABLED

# Comma-separated list of allowed CORS origins (React app).
# Local: http://localhost:5173,http://127.0.0.1:5173
# Production: https://<your-vercel-app>.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Comma-separated list of CSRF trusted origins (must include scheme://host).
# Same values as CORS_ALLOWED_ORIGINS in production.
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to "true" in production to force HTTPS, secure cookies, and HSTS.
SECURE_SSL_REDIRECT=false
