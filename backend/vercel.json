{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "uv run --python 3.14 --with-requirements requirements.txt python manage.py collectstatic --noinput",
  "outputDirectory": "staticfiles",
  "functions": {
    "api/index.py": {
      "includeFiles": "staticfiles/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
