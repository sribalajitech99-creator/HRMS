# Frontend environment variables
# Copy this file to `.env` for local development and fill in real values.
# NEVER commit your actual `.env` file with real values.

# Base URL of the Django REST backend API.
# Local development:
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Production (set in Vercel project settings -> Environment Variables):
# VITE_API_BASE_URL=https://<your-render-backend-url>/api/v1
